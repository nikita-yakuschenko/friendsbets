# =============================================================================
# Dokploy → Compose (Frontend) → Environment
# Скопируйте блок «ВСТАВИТЬ В DOKPLOY» целиком, подставьте реальный пароль БД и секреты.
# Не коммитьте файл с реальными паролями (этот шаблон — в git).
#
# Пароль в DATABASE_URL: если есть @ # % & и т.п. — закодируйте (URL-encode).
# PowerShell — случайная строка для SESSION_SECRET / CRON_SECRET:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# =============================================================================

# --- ВСТАВИТЬ В DOKPLOY (без строк с #) ---

DATABASE_URL=postgresql://friendsbets:ВСТАВЬТЕ_ПАРОЛЬ_ИЗ_КАРТОЧКИ_БД@friendsbetsdb-p8dn1v:5432/friendsbets?schema=public

APP_PORT=3000
SESSION_SECRET=ВСТАВЬТЕ_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА
CRON_SECRET=ВСТАВЬТЕ_СЛУЧАЙНУЮ_СТРОКУ
# Письма и ссылки (verify, сброс пароля). Без / в конце. При docker build желательно тот же URL.
NEXT_PUBLIC_APP_URL=https://ваш-домен.ru

RUN_DB_SEED=true
SKIP_CHAMPIONAT_SEED=true

ADMIN_EMAIL=admin@ваш-домен.ru
ADMIN_PASSWORD=ВСТАВЬТЕ_ПАРОЛЬ_АДМИНА

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FriendsBets <noreply@friendsbets.ru>
# BIMI + DMARC для лого в Gmail — docs/EMAIL_AVATAR.md

CHAMPIONAT_TOURNAMENT_ID=6858
CHAMPIONAT_SPORT_SLUG=_worldcup

# Telegram — docs/TELEGRAM_BOT.md (webhook ставится при старте, если URL https)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=friendsbets_bot
# TELEGRAM_WEBHOOK_SECRET=случайная_длинная_строка
# TELEGRAM_CHANNEL_ID=@friendsbets
# TELEGRAM_CHANNEL_URL=https://t.me/friendsbets
# NEXT_PUBLIC_APP_URL=https://friendsbets.ru

# Аватары (Supabase Storage или S3) — docs/AVATAR_STORAGE.md
# AVATAR_STORAGE=supabase
# SUPABASE_URL=https://ваш-supabase-домен
# SUPABASE_PUBLIC_URL=https://ваш-supabase-домен
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=avatars
# AVATAR_STORAGE=s3
# S3_ENDPOINT=https://s3.provider.com
# S3_REGION=ru-1
# S3_BUCKET=friendsbets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.ваш-домен.ru
# S3_FORCE_PATH_STYLE=true
