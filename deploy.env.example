# Шаблон Environment для Dokploy → Docker Compose (только app, docker-compose.yml).
# PostgreSQL создаётся отдельно: Dokploy → Databases → PostgreSQL.
# Скопируйте значения в UI Environment (не коммитьте реальные секреты).
#
# PowerShell — случайная строка:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])

# --- Подключение к БД (Internal Host из карточки Databases, без external port) ---
DATABASE_URL=postgresql://friendsbets:ПАРОЛЬ@friendsbetsdb-XXXXXX:5432/friendsbets?schema=public

# --- Приложение ---
APP_PORT=3000
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.example
CRON_SECRET=

RUN_DB_SEED=true
SKIP_CHAMPIONAT_SEED=true

ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FriendsBets <noreply@your-domain.example>

CHAMPIONAT_TOURNAMENT_ID=6858
CHAMPIONAT_SPORT_SLUG=_worldcup
