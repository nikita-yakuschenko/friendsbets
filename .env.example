# Локальная разработка (postgres на localhost)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/friendsbets?schema=public

# Docker Compose / Dokploy (заполните для деплоя; DATABASE_URL в compose собирается сам)
POSTGRES_USER=friendsbets
POSTGRES_PASSWORD=
POSTGRES_DB=friendsbets
APP_PORT=3000

SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

RUN_DB_SEED=true
SKIP_CHAMPIONAT_SEED=true

ADMIN_EMAIL=admin@friendsbets.local
ADMIN_PASSWORD=

# SMTP (если не задано — письма пишутся в консоль)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FriendsBets <noreply@friendsbets.local>

# Championat sync (ЧМ-2026)
CHAMPIONAT_TOURNAMENT_ID=6858
CHAMPIONAT_SPORT_SLUG=_worldcup
# CHAMPIONAT_SYNC_TOURNAMENT_ID=
