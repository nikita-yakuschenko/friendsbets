# Локальная разработка (npm run dev)
# Postgres: docker compose up -d postgres — учётные данные как в POSTGRES_* ниже
DATABASE_URL=postgresql://friendsbets:CHANGE_ME@localhost:5432/friendsbets?schema=public

# Docker Compose / Dokploy (DATABASE_URL в контейнере app собирается из POSTGRES_*)
POSTGRES_USER=friendsbets
POSTGRES_PASSWORD=
POSTGRES_DB=friendsbets
APP_PORT=3000

SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

RUN_DB_SEED=true
SKIP_CHAMPIONAT_SEED=true

ADMIN_EMAIL=admin@friendsbets.local
ADMIN_PASSWORD=

# SMTP (если не задано — письма пишутся в консоль)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FriendsBets <noreply@friendsbets.local>

# Championat sync (ЧМ-2026)
CHAMPIONAT_TOURNAMENT_ID=6858
CHAMPIONAT_SPORT_SLUG=_worldcup
# CHAMPIONAT_SYNC_TOURNAMENT_ID=
