# =============================================================================
# Локальная разработка (npm run dev)
# =============================================================================
# 1) Поднять БД:  npm run docker:db
# 2) Миграции:    npm run db:migrate
# 3) Dev-сервер:  npm run dev

DATABASE_URL=postgresql://friendsbets:CHANGE_ME@localhost:5433/friendsbets?schema=public

# Для docker-compose.db.yml (локальный контейнер postgres)
POSTGRES_USER=friendsbets
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=friendsbets

# =============================================================================
# Опционально: та же БД, что на сервере (миграции до деплоя app)
# =============================================================================
# Раскомментируйте и подставьте Internal Connection URL из Dokploy Databases.
# Нужен SSH-туннель или временный external port на VPS — см. docs/DATABASE.md
# DATABASE_URL=postgresql://friendsbets:PROD_PASSWORD@127.0.0.1:5435/friendsbets?schema=public

APP_PORT=3000
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

RUN_DB_SEED=true
SKIP_CHAMPIONAT_SEED=true

ADMIN_EMAIL=admin@friendsbets.local
ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FriendsBets <noreply@friendsbets.local>

CHAMPIONAT_TOURNAMENT_ID=6858
CHAMPIONAT_SPORT_SLUG=_worldcup

# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
