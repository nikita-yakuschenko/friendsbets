# Локальная разработка (npm run dev)
# Postgres: docker compose up -d postgres — порт 5433 (не 5432: на Windows часто занят своим PostgreSQL)
DATABASE_URL=postgresql://friendsbets:CHANGE_ME@localhost:5433/friendsbets?schema=public

# Docker Compose / Dokploy (DATABASE_URL в контейнере app собирается из POSTGRES_*)
POSTGRES_USER=friendsbets
POSTGRES_PASSWORD=
POSTGRES_DB=friendsbets
APP_PORT=3000

SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Полный seed (суперадмин + опционально Championat). Правила очков и шаблон ЧМ создаются
# всегда: при старте app (instrumentation) и в Docker entrypoint (db:essentials).
RUN_DB_SEED=true
SKIP_CHAMPIONAT_SEED=true

# Суперадмин платформы (один аккаунт, создаётся seed)
ADMIN_EMAIL=admin@friendsbets.local
# Пустое значение = admin123456. После смены: npm run admin:sync-password
ADMIN_PASSWORD=g0sDZ6V9

# SMTP (если не задано — письма пишутся в консоль)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FriendsBets <noreply@friendsbets.local>

# Championat sync (ЧМ-2026)
CHAMPIONAT_TOURNAMENT_ID=6858
CHAMPIONAT_SPORT_SLUG=_worldcup
# CHAMPIONAT_SYNC_TOURNAMENT_ID=
# CHAMPIONAT_SYNC_CONCURRENCY=3

# PostgreSQL pool (опционально, дефолты в src/lib/db.ts)
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
